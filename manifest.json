{
  "manifest_version": 3,
  "name": "Randsight",
  "version": "1.7.0",
  "description": "Joint-model set prediction and damage calculator for Pokemon Showdown Random Battles.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://data.pkmn.cc/*",
    "https://raw.githubusercontent.com/pkmn/randbats/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://play.pokemonshowdown.com/*",
        "https://replay.pokemonshowdown.com/*"
      ],
      "js": [
        "src/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://play.pokemonshowdown.com/*",
        "https://replay.pokemonshowdown.com/*"
      ],
      "js": [
        "src/vendor/calc.js",
        "src/formats.js",
        "src/engine.js",
        "src/joint.js",
        "src/damage.js",
        "src/advice.js",
        "src/ui.js",
        "src/content.js"
      ],
      "css": [
        "src/overlay.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Randsight",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/data/*.json"
      ],
      "matches": [
        "https://play.pokemonshowdown.com/*",
        "https://replay.pokemonshowdown.com/*"
      ]
    }
  ]
}